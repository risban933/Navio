{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0.0",
    "icons": {
        "16": "images/icon-16.png",
        "19": "images/icon-19.png",
        "32": "images/icon-32.png",
        "38": "images/icon-38.png",
        "48": "images/icon-48.png",
        "64": "images/icon-64.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "js": [
                "lib/urlConversion.js",
                "lib/settings.js",
                "lib/stats.js",
                "content.js"
            ],
            "matches": [
                "*://google.com/*",
                "*://*.google.com/*",
                "*://google.co.uk/*",
                "*://*.google.co.uk/*",
                "*://google.ca/*",
                "*://*.google.ca/*",
                "*://google.com.au/*",
                "*://*.google.com.au/*",
                "*://google.de/*",
                "*://*.google.de/*",
                "*://google.fr/*",
                "*://*.google.fr/*",
                "*://google.es/*",
                "*://*.google.es/*",
                "*://google.it/*",
                "*://*.google.it/*",
                "*://google.co.jp/*",
                "*://*.google.co.jp/*",
                "*://google.co.in/*",
                "*://*.google.co.in/*",
                "*://google.com.br/*",
                "*://*.google.com.br/*",
                "*://google.ru/*",
                "*://*.google.ru/*",
                "*://google.co.kr/*",
                "*://*.google.co.kr/*",
                "*://google.com.mx/*",
                "*://*.google.com.mx/*",
                "*://google.nl/*",
                "*://*.google.nl/*",
                "*://google.pl/*",
                "*://*.google.pl/*",
                "*://google.se/*",
                "*://*.google.se/*",
                "*://google.ch/*",
                "*://*.google.ch/*",
                "*://google.at/*",
                "*://*.google.at/*",
                "*://google.be/*",
                "*://*.google.be/*"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon-16.png",
            "19": "images/icon-19.png",
            "32": "images/icon-32.png",
            "38": "images/icon-38.png"
        },
        "default_title": "Navio"
    },
    "permissions": [
        "nativeMessaging",
        "storage"
    ],
    "host_permissions": [
        "*://google.com/*",
        "*://*.google.com/*",
        "*://google.co.uk/*",
        "*://*.google.co.uk/*",
        "*://google.ca/*",
        "*://*.google.ca/*",
        "*://google.com.au/*",
        "*://*.google.com.au/*",
        "*://google.de/*",
        "*://*.google.de/*",
        "*://google.fr/*",
        "*://*.google.fr/*",
        "*://google.es/*",
        "*://*.google.es/*",
        "*://google.it/*",
        "*://*.google.it/*",
        "*://google.co.jp/*",
        "*://*.google.co.jp/*",
        "*://google.co.in/*",
        "*://*.google.co.in/*",
        "*://google.com.br/*",
        "*://*.google.com.br/*",
        "*://google.ru/*",
        "*://*.google.ru/*",
        "*://google.co.kr/*",
        "*://*.google.co.kr/*",
        "*://google.com.mx/*",
        "*://*.google.com.mx/*",
        "*://google.nl/*",
        "*://*.google.nl/*",
        "*://google.pl/*",
        "*://*.google.pl/*",
        "*://google.se/*",
        "*://*.google.se/*",
        "*://google.ch/*",
        "*://*.google.ch/*",
        "*://google.at/*",
        "*://*.google.at/*",
        "*://google.be/*",
        "*://*.google.be/*"
    ]
}
